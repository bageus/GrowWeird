; Engine configuration file.
; Prefer changing project settings through the Godot editor unless a setting is intentionally version-controlled here.

config_version=5

[application]

config/name="GrowWeird"
run/main_scene="res://src/presentation/main/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

PlatformRuntime="*res://src/infrastructure/platform/platform_runtime.gd"
GameApp="*res://src/application/game_app.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
