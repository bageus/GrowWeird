[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/presentation/main/main_screen.gd" id="1_main"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "GrowWeird — architecture smoke screen"

[node name="StatusLabel" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
text = "Loading state..."

[node name="PlantPlaceholder" type="PanelContainer" parent="Margin/Layout"]
custom_minimum_size = Vector2(0, 180)
layout_mode = 2
size_flags_vertical = 3

[node name="Center" type="CenterContainer" parent="Margin/Layout/PlantPlaceholder"]
layout_mode = 2

[node name="Label" type="Label" parent="Margin/Layout/PlantPlaceholder/Center"]
layout_mode = 2
text = "PLANT VIEW PLACEHOLDER\nleft  |  center  |  right"
horizontal_alignment = 1

[node name="Environment" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="WaterButton" type="Button" parent="Margin/Layout/Environment"]
layout_mode = 2
text = "Water"

[node name="SprayButton" type="Button" parent="Margin/Layout/Environment"]
layout_mode = 2
text = "Spray"

[node name="WindowButton" type="Button" parent="Margin/Layout/Environment"]
unique_name_in_owner = true
layout_mode = 2
text = "Window"

[node name="LightButton" type="Button" parent="Margin/Layout/Environment"]
unique_name_in_owner = true
layout_mode = 2
text = "Light"

[node name="OfferLabel" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
text = "Fertilizer offer"

[node name="Offers" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="OfferOne" type="Button" parent="Margin/Layout/Offers"]
unique_name_in_owner = true
layout_mode = 2
text = "Offer 1"

[node name="OfferTwo" type="Button" parent="Margin/Layout/Offers"]
unique_name_in_owner = true
layout_mode = 2
text = "Offer 2"

[node name="OfferThree" type="Button" parent="Margin/Layout/Offers"]
unique_name_in_owner = true
layout_mode = 2
text = "Offer 3"

[node name="SkipOffer" type="Button" parent="Margin/Layout/Offers"]
unique_name_in_owner = true
layout_mode = 2
text = "Skip"

[node name="Propagation" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PruneLeft" type="Button" parent="Margin/Layout/Propagation"]
layout_mode = 2
text = "Prune left"

[node name="PruneCenter" type="Button" parent="Margin/Layout/Propagation"]
layout_mode = 2
text = "Prune center"

[node name="PruneRight" type="Button" parent="Margin/Layout/Propagation"]
layout_mode = 2
text = "Prune right"

[node name="PlantCutting" type="Button" parent="Margin/Layout/Propagation"]
layout_mode = 2
text = "Plant first cutting → Pot 2"

[node name="GraftCutting" type="Button" parent="Margin/Layout/Propagation"]
layout_mode = 2
text = "Graft first cutting"

[node name="Pots" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
